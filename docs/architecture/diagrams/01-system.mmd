    PM --> K
    K --> I
    I --> H
  end
  subgraph OP["5 · Native action / effect"]
    direction TB
    P["Human applies exact Guild DENY<br/>Native UI / verified CLI; no assumed REST mutation"]
    F["Fresh target operation<br/>Actual native refusal for matching scope"]
    B2["Fresh approved control<br/>Inspect actual expected synthetic result"]
    Z["Receipt in journal + sanitized read-only demo<br/>Observed matching restriction / residual scope"]
