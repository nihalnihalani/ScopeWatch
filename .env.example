# ScopeWatch configuration names (application config, not native API payload fields).
# Values are intentionally blank. Never commit filled values. `npm run doctor` reports presence only.
#
# SCOPEWATCH_MODE: native | replay | contract_test
#   native        real Guild + ClickHouse; missing settings => UNCONFIGURED (never falls back to replay)
#   replay        separately namespaced synthetic data; never action eligible
#   contract_test adapter against a LOOPBACK mock Guild API (tests only); never evidence
SCOPEWATCH_MODE=
SCOPEWATCH_BIND_HOST=127.0.0.1
SCOPEWATCH_PORT=
SCOPEWATCH_OPERATOR_SECRET=
SCOPEWATCH_OPERATOR_NAME=
SCOPEWATCH_SQLITE_PATH=
SCOPEWATCH_ALLOWED_ORIGINS=
# Expected control fixture marker: server-side only, never placed in a model prompt.
SCOPEWATCH_CONTROL_EXPECTED_MARKER=

GUILD_API_BASE_URL=https://api.guild.ai
GUILD_TRIGGER_ID=
GUILD_TRIGGER_SECRET=
GUILD_COLLECTOR_KEY_ID=
GUILD_COLLECTOR_KEY_SECRET=
GUILD_WORKSPACE_ID=
GUILD_WORKSPACE_OWNER=
GUILD_WORKSPACE_NAME=
GUILD_TARGET_INSTALLED_AGENT_ID=
GUILD_CONTROL_INSTALLED_AGENT_ID=
GUILD_INVESTIGATOR_INSTALLED_AGENT_ID=
GUILD_VERIFIED_TARGET_POLICY_SUBJECT_ID=
GUILD_VERIFIED_CONTROL_POLICY_SUBJECT_ID=
GUILD_VERIFIED_CREDENTIAL_ID=
GUILD_VERIFIED_OPERATION=
OWNED_GITHUB_OWNER=
OWNED_GITHUB_REPO=
# Set only after native proof: agent ref → policy subject JSON, identity domain, probe ticket
GUILD_AGENT_SUBJECT_MAP=
GUILD_IDENTITY_DOMAIN=
GUILD_PROBE_TICKET_NUMBER=
PINNED_MANIFEST_PATH=
PINNED_MANIFEST_REF=

# ClickHouse (Cloud HTTPS URL, or http://127.0.0.1:18123 for the local docker server: labeled clickhouse_local)
CLICKHOUSE_URL=
CLICKHOUSE_DATABASE=
CLICKHOUSE_INGEST_USERNAME=
CLICKHOUSE_INGEST_PASSWORD=
CLICKHOUSE_QUERY_USERNAME=
CLICKHOUSE_QUERY_PASSWORD=
CLICKHOUSE_REPLAY_DATABASE=
CLICKHOUSE_REPLAY_INGEST_USERNAME=
CLICKHOUSE_REPLAY_INGEST_PASSWORD=
CLICKHOUSE_REPLAY_QUERY_USERNAME=
CLICKHOUSE_REPLAY_QUERY_PASSWORD=
CLICKHOUSE_CONTRACT_DATABASE=
CLICKHOUSE_CONTRACT_INGEST_USERNAME=
CLICKHOUSE_CONTRACT_INGEST_PASSWORD=
CLICKHOUSE_CONTRACT_QUERY_USERNAME=
CLICKHOUSE_CONTRACT_QUERY_PASSWORD=
# Local docker admin (schema/grant setup only; never used by the running app)
SCOPEWATCH_CH_ADMIN_PASSWORD=
# Semgrep uses its documented IDE/OAuth setup outside app runtime.
