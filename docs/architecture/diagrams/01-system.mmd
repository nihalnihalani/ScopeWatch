    T --> B
    A --> X
    B --> X
    V --> X
    X --> E
  end
  subgraph CT["2 · Trusted controller"]
    direction TB
    L["Server-held launch / read keys<br/>Allowlisted native launch registry"]
    C["Collector + event-specific binding<br/>Complete captured cohort; unknowns stay unknown"]
    J[("SQLite control journal<br/>Raw snapshots · revisions · approval / action states")]
    S["Canonical generation admission<br/>All-version conflict check before filters"]
    L --> C
    C --> J
    J --> S
  end
  subgraph CH["3 · ClickHouse evidence"]
    direction TB
    D[("Raw / canonical generation + context<br/>Publish ACK + exact ID-set readback")]
    Q["Parameterized all-candidate SQL<br/>Unique ALLOW count / own allowance"]
